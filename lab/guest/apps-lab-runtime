#!/usr/bin/env bash
# The apps lab's runtime in the VM: bring Boardfarm's providers up, then the routers, then
# the LAN clients, in that order; and take the routers down again.
set -euo pipefail
exec </dev/null

. /etc/default/apps-lab
state=/var/lib/apps-lab
workspace=/opt/boardfarm
lab_repo=$workspace/boardfarm-lab-staging
bf_lab=$workspace/.venv/bin/bf-lab
export BF_LAB_CONFIG=apps-lab.json BF_INVENTORY=apps-lab.json

cpes() {    # the Boardfarm slots the lab's configuration has
    seq 1 "$(jq -r .deployment.num_cpes "$lab_repo/lab/$BF_LAB_CONFIG")"
}

routers() {    # "name framework cpe" per line
    local router
    for router in $APPS_LAB_ROUTERS; do
        printf '%s\n' "${router//:/ }"
    done
}

running() {    # every named Docker container runs
    local container
    for container in "$@"; do
        [ "$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null)" = true ] || return 1
    done
}

bridge_of() {
    docker network inspect "$1" -f '{{index .Options "com.docker.network.bridge.name"}}' 2>/dev/null
}

# Every provider container is on two Docker networks: Boardfarm's management network of
# its kind, which has to be its eth0, and its slot's WAN or LAN network, its eth1. bf-lab
# gets that order by starting the container on the management network alone and
# connecting the slot's network afterwards. A container Docker starts with both networks
# (a restart, a VM boot) can come up with the two swapped, and its init then configures
# the wrong one. So the lab connects the slot's network again with its interface name
# fixed (Docker 28 and later), which holds across restarts.
ifname_option=com.docker.network.endpoint.ifname

management() {    # the management network of a kind (dhcp, wan, lan): "name gateway prefix"
    jq -r --arg kind "$1" '.docker_networks[$kind + "_management"]
        | "\(.name) \(.gateway) \(.subnet | sub("\\.[0-9]+/[0-9]+$"; ""))"' "$lab_repo/lab/base.json"
}

eth0_is_management() {    # container kind
    local network gateway prefix
    read -r network gateway prefix < <(management "$2")
    docker exec "$1" ip -4 -o address show eth0 2>/dev/null | grep -q " $prefix\."
}

pinned() {    # container network: the network's interface in the container is fixed to eth1
    docker inspect "$1" \
        -f "{{index (index .NetworkSettings.Networks \"$2\").DriverOpts \"$ifname_option\"}}" \
        2>/dev/null | grep -qx eth1
}

connected() {    # container network
    docker inspect "$1" -f '{{range $name, $_ := .NetworkSettings.Networks}}{{$name}} {{end}}' 2>/dev/null |
        grep -qw -- "$2"
}

# Connect a container's slot network again as eth1 (with the address bf-lab gives a server
# there) and start the container again, so that its init configures the interface. A
# connect can fail while the container is busy with the interface (its init removes the
# address Docker has just given it, and Docker then finds no route to the network's
# gateway), so it is tried a few times. On a Docker that cannot fix the name: the way bf-lab
# deploys it, on the management network alone, then the slot's network.
reattach() {    # container network [docker network connect options]
    local container=$1 network=$2 attempt error=
    shift 2
    for attempt in 1 2 3 4 5; do
        docker network disconnect "$network" "$container" >/dev/null 2>&1 || true
        # Docker makes the network it connects the default route, and gives up when the
        # container has one of its own making (the WAN gateway's). The restart below
        # brings the container's own routes back.
        docker exec "$container" ip route del default >/dev/null 2>&1 || true
        if error=$(docker network connect --driver-opt "$ifname_option=eth1" "$@" "$network" "$container" 2>&1); then
            docker restart -t 2 "$container" >/dev/null
            return 0
        fi
        sleep 2
    done
    echo "$container: $network not connected with a fixed interface name: $error" >&2
    for attempt in 1 2 3 4 5; do
        docker network disconnect "$network" "$container" >/dev/null 2>&1 || true
        docker restart -t 2 "$container" >/dev/null
        sleep 3
        if error=$(docker network connect "$@" "$network" "$container" 2>&1); then
            return 0
        fi
    done
    echo "$container: $network not connected: $error" >&2
    return 1
}

slot_connect_options() {    # kind cpe: what bf-lab passes when it connects the slot's network
    local index=$((100 + $2))
    case "$1" in
        dhcp) printf '%s\n' --ip "10.$index.0.10" --ip6 "2001:dead:beef:$index::10" ;;
        wan) printf '%s\n' --ip "10.$index.0.20" --ip6 "2001:dead:beef:$index::20" ;;
    esac
}

slot_network() {    # kind cpe
    case "$1" in dhcp|wan) echo "wan-cpe$2" ;; lan) echo "lan-cpe$2" ;; esac
}

reattach_provider() {    # kind cpe
    local options
    mapfile -t options < <(slot_connect_options "$1" "$2")
    reattach "$1-cpe$2" "$(slot_network "$1" "$2")" "${options[@]}"
}

# The WAN gateway reaches the internet through the management network and masquerades
# there. Connected to its WAN network while it runs, it has Docker's gateway on that
# network as its default route instead, and forwards nowhere.
wan_routes_out() {
    docker exec "wan-cpe$1" ip -4 route show default 2>/dev/null | grep -q ' dev eth0'
}

# A slot is ready when its three containers run on the slot's two bridges with their
# interfaces in order, the Kea server and the gateway have their WAN addresses, the gateway
# routes out, and Kea serves both families. slot_problem names the first of these that
# does not hold.
slot_problem() {
    local i=$1 index=$((100 + $1)) container
    for container in "dhcp-cpe$i" "wan-cpe$i" "lan-cpe$i"; do
        running "$container" || { echo "$container does not run"; return; }
    done
    [ "$(bridge_of "wan-cpe$i")" = "br-wan$index" ] && ip link show "br-wan$index" >/dev/null 2>&1 ||
        { echo "no bridge br-wan$index for the network wan-cpe$i"; return; }
    [ "$(bridge_of "lan-cpe$i")" = "br-lan$((200 + i))" ] && ip link show "br-lan$((200 + i))" >/dev/null 2>&1 ||
        { echo "no bridge br-lan$((200 + i)) for the network lan-cpe$i"; return; }
    for container in dhcp wan lan; do
        connected "$container-cpe$i" "$(slot_network "$container" "$i")" ||
            { echo "$container-cpe$i is not connected to the network $(slot_network "$container" "$i")"; return; }
        eth0_is_management "$container-cpe$i" "$container" ||
            { echo "$container-cpe$i: eth0 is not its management interface"; return; }
    done
    docker exec "dhcp-cpe$i" ip -4 address show eth1 2>/dev/null | grep -q "10\.$index\.0\.10/24" ||
        { echo "dhcp-cpe$i is not at 10.$index.0.10"; return; }
    docker exec "wan-cpe$i" ip -4 address show eth1 2>/dev/null | grep -q "10\.$index\.0\.20/24" ||
        { echo "wan-cpe$i is not at 10.$index.0.20"; return; }
    wan_routes_out "$i" || { echo "wan-cpe$i does not route out through eth0"; return; }
    docker exec "dhcp-cpe$i" pidof kea-dhcp4 >/dev/null 2>&1 || { echo "dhcp-cpe$i: Kea DHCPv4 does not run"; return; }
    docker exec "dhcp-cpe$i" pidof kea-dhcp6 >/dev/null 2>&1 || { echo "dhcp-cpe$i: Kea DHCPv6 does not run"; return; }
}

boardfarm_problems() {
    local i problem
    for i in $(cpes); do
        problem=$(slot_problem "$i")
        [ -z "$problem" ] || printf '%s\n' "$problem"
    done
}

boardfarm_ready() {
    [ -z "$(boardfarm_problems)" ]
}

wait_boardfarm_ready() {    # [seconds]
    local deadline=$((SECONDS + ${1:-30}))
    while ! boardfarm_ready; do
        [ "$SECONDS" -lt "$deadline" ] || return 1
        sleep 2
    done
}

stop_routers() {
    local name framework cpe
    while read -r name framework cpe; do
        if [ "$(lxc info "$name" 2>/dev/null | sed -n 's/^Status: //p')" = RUNNING ]; then
            lxc stop "$name" --timeout 60 || lxc stop "$name" --force
        fi
    done < <(routers)
}

# What can be repaired without setting Boardfarm up again: interfaces in the wrong order,
# Kea's stale PID files, the gateway's default route.
repair_providers() {
    local i kind network gateway prefix
    for i in $(cpes); do
        if running "dhcp-cpe$i" && { ! docker exec "dhcp-cpe$i" pidof kea-dhcp4 >/dev/null 2>&1 ||
                ! docker exec "dhcp-cpe$i" pidof kea-dhcp6 >/dev/null 2>&1; }; then
            # Kea leaves its PID files in the container's writable layer; after a power-off
            # they name processes that no longer exist and Kea (either family) does not start.
            docker exec "dhcp-cpe$i" sh -c 'rm -f /var/run/kea/*.pid /run/kea/*.pid' || true
            reattach_provider dhcp "$i" || true
        fi
        for kind in dhcp wan lan; do
            if running "$kind-cpe$i" && { ! connected "$kind-cpe$i" "$(slot_network "$kind" "$i")" ||
                    ! eth0_is_management "$kind-cpe$i" "$kind"; }; then
                reattach_provider "$kind" "$i" || true
            fi
        done
        if running "wan-cpe$i" && eth0_is_management "wan-cpe$i" wan && ! wan_routes_out "$i"; then
            read -r network gateway prefix < <(management wan)
            docker exec "wan-cpe$i" ip route replace default via "$gateway" dev eth0 || true
        fi
    done
}

# Fix the interface names of every provider that does not have them fixed yet.
pin_providers() {
    local i kind
    for i in $(cpes); do
        for kind in dhcp wan lan; do
            pinned "$kind-cpe$i" "$(slot_network "$kind" "$i")" || reattach_provider "$kind" "$i" || true
        done
    done
}

providers_exist() {    # every provider container is there, running or not
    local i kind
    for i in $(cpes); do
        for kind in dhcp wan lan; do
            docker container inspect "$kind-cpe$i" >/dev/null 2>&1 || return 1
        done
    done
}

settle_boardfarm() {    # wait for readiness, repairing what can be repaired
    local attempt
    for attempt in 1 2 3; do
        wait_boardfarm_ready 45 && return 0
        echo "Boardfarm is not ready (round $attempt/3):"
        boardfarm_problems | sed 's/^/  /'
        repair_providers
    done
    wait_boardfarm_ready 45
}

boardfarm_up() {
    local i attempt
    test -x "$bf_lab"
    test -f "$lab_repo/lab/$BF_LAB_CONFIG"
    # Docker keeps the containers and their networks across a VM reboot: start what is
    # there before deciding that the lab has to be set up again.
    for i in $(cpes); do
        docker start "dhcp-cpe$i" "wan-cpe$i" "lan-cpe$i" >/dev/null 2>&1 || true
    done
    if ! providers_exist; then
        echo 'Boardfarm is not set up yet'
    fi
    if ! providers_exist || ! settle_boardfarm; then
        echo 'Setting Boardfarm up:'
        boardfarm_problems | sed 's/^/  /'
        # Setting the lab up removes and recreates the bridges the routers are on.
        stop_routers
        cd "$lab_repo/lab"
        # Not bf-lab status here: it wants SSH on the LAN clients, which they only start
        # once they have waited for a router that is not up yet.
        for attempt in 1 2 3; do
            echo "Boardfarm setup attempt $attempt/3"
            if "$bf_lab" teardown,setup; then
                break
            fi
            [ "$attempt" -lt 3 ] || { echo 'Boardfarm setup failed' >&2; return 1; }
            sleep $((attempt * 10))
        done
    fi
    pin_providers
    settle_boardfarm || {
        echo 'Boardfarm is set up but not ready:' >&2
        boardfarm_problems | sed 's/^/  /' >&2
        return 1
    }
    for i in $(cpes); do
        docker update --restart unless-stopped "dhcp-cpe$i" "wan-cpe$i" "lan-cpe$i" >/dev/null
    done
    # Docker turns bridge netfilter on with every network it creates; with it, a frame
    # bridged between a router and its providers is judged by Docker's isolation rules.
    modprobe br_netfilter
    sysctl -q -w net.bridge.bridge-nf-call-iptables=0 net.bridge.bridge-nf-call-ip6tables=0
    date -Ins > "$state/boardfarm.completed-at"
    printf '%s\n' 'boardfarm-ready' > "$state/boardfarm.status"
}

# The LAN client's address from the router, if it has one. Not the address Docker gives
# the interface when it connects the network: the client's init removes that one first.
lan_lease() {
    local docker_address
    eth0_is_management "lan-cpe$1" lan || return 0
    docker_address=$(docker inspect "lan-cpe$1" \
        -f "{{(index .NetworkSettings.Networks \"lan-cpe$1\").IPAddress}}" 2>/dev/null)
    docker exec "lan-cpe$1" ip -4 -o address show eth1 2>/dev/null |
        awk -v docker="$docker_address" '{split($4, a, "/"); if (a[1] != docker) {print $4; exit}}'
}

# The LAN client asks for its address once, when its container starts. Started before the
# router's LAN was up it has none (and has skipped its services), so it is started again.
lan_clients_up() {
    local name framework cpe attempt
    while read -r name framework cpe; do
        [ -z "$(lan_lease "$cpe")" ] || continue
        if pinned "lan-cpe$cpe" "lan-cpe$cpe"; then
            docker restart -t 2 "lan-cpe$cpe" >/dev/null
        else
            reattach_provider lan "$cpe"
        fi
    done < <(routers)
    while read -r name framework cpe; do
        for attempt in $(seq 1 90); do
            [ -z "$(lan_lease "$cpe")" ] || break
            sleep 1
        done
        echo "lan-cpe$cpe: ${name}'s LAN address $(lan_lease "$cpe")"
        [ -n "$(lan_lease "$cpe")" ]
    done < <(routers)
}

start() {
    local name framework cpe
    lxd waitready --timeout 300
    boardfarm_up
    while read -r name framework cpe; do
        lxc info "$name" >/dev/null 2>&1 || { echo "$name is not deployed" >&2; continue; }
        [ "$(lxc info "$name" | sed -n 's/^Status: //p')" = RUNNING ] || lxc start "$name"
    done < <(routers)
    while read -r name framework cpe; do
        lxc info "$name" >/dev/null 2>&1 || continue
        /usr/local/sbin/apps-lab-router wait "$name"
    done < <(routers)
    lan_clients_up
    date -Ins > "$state/runtime.completed-at"
}

case "${1:-}" in
    start) start ;;
    stop) stop_routers ;;
    boardfarm) lxd waitready --timeout 300; boardfarm_up ;;
    lan) lan_clients_up ;;
    *) echo "usage: $(basename "$0") start|stop|boardfarm|lan" >&2; exit 2 ;;
esac
