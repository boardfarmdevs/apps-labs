# The apps lab VM: its pins and sizes. Sourced by lab/build.sh on the host and installed in
# the VM as /etc/default/apps-lab; an environment variable of the same name overrides a line.

# The VM
APPS_LAB_NAME=${APPS_LAB_NAME:-apps-lab}
APPS_LAB_IMAGE=${APPS_LAB_IMAGE:-ubuntu:24.04}
APPS_LAB_CPUS=${APPS_LAB_CPUS:-4}
APPS_LAB_MEMORY=${APPS_LAB_MEMORY:-8GiB}
APPS_LAB_DISK=${APPS_LAB_DISK:-40GiB}
APPS_LAB_NETWORK=${APPS_LAB_NETWORK:-lxdbr0}

# Boardfarm: the WAN and LAN providers (the commit the RDK EasyMesh lab pins)
BOARDFARM_SOURCE=${BOARDFARM_SOURCE:-git@github.com:robvogelaar/boardfarm-lab-staging.git}
BOARDFARM_COMMIT=${BOARDFARM_COMMIT:-ddb5a2b9e1707562595afc7e4000a3b8efa3cd81}

# The routers, as "name:framework:cpe": the Boardfarm CPE slot gives the bridges
# (br-wan10<cpe>, br-lan20<cpe>) and the provider containers (dhcp-, wan-, lan-cpe<cpe>)
APPS_LAB_ROUTERS=${APPS_LAB_ROUTERS:-"bpibroadband-dac:dac:1 bpibroadband-lcm:lcm:2"}
ROUTER_CPUS=${ROUTER_CPUS:-2}
ROUTER_MEMORY=${ROUTER_MEMORY:-2GiB}
ROUTER_ROOT=${ROUTER_ROOT:-4GiB}

# The nested LXD pool the routers' root disks are on
ROUTER_POOL=${ROUTER_POOL:-routers}
ROUTER_POOL_SIZE=${ROUTER_POOL_SIZE:-20GiB}
